<Window x:Class="GlslWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GlslWallpaper"
        xmlns:internal="clr-namespace:GlslWallpaper.Internals"
        mc:Ignorable="d"
        Title="GLSL Wallpaper"
        Height="240" Width="300"
        SizeToContent="WidthAndHeight" 
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded">
    <Window.Resources>
        <internal:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="6,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Shader Source" Grid.Row="0" Grid.Column="0" Margin="3,3,3,3">
            <Grid x:Name="_gridShaderSource" Margin="3,3,3,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.Column="0" Margin="3,3,3,3">
            <GroupBox.Header>
                <CheckBox x:Name ="_checkBoxSlide" Content="Slide Show" Checked="CheckBoxSlideShow_Checked" Unchecked="CheckBoxSlideShow_Unchecked"/>
            </GroupBox.Header>
            <Grid Margin="3,3,3,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="AUto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Source" Grid.Row="0" Grid.Column="0" Margin="3,3,3,3"/>
                <TextBox x:Name="_textBoxSlideShowSource" AllowDrop="True"
                     Grid.Row="0" Grid.Column="1" Margin="3,6,3,6"
                     TextChanged="TextBoxSlideShowSource_TextChanged"
                     Drop="TextBoxSlideShowSource_Drop"
                     PreviewDragOver="TextBoxSlideShowSource_PreviewDragOver"></TextBox>
                <Button Content="..." Grid.Row="0" Grid.Column="2" Margin="3,6,3,6" Click="ButtonSetSlideShowSource_Click"></Button>

                <Label Content="Interval" Grid.Row="1" Grid.Column="0" Margin="3,3,3,3"/>
                <Slider
                    Value="{Binding Path=Value, ElementName=integerUpDownflipInterval, Mode=TwoWay}" Minimum="1" Maximum="300"
                    VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="3,0,3,0" MinWidth="100"
                    ValueChanged="SliderSlideShowInterval_ValueChanged"/>
                <xctk:IntegerUpDown Name="integerUpDownflipInterval" Value="10" Minimum="1" Maximum="300" Grid.Row="1" Grid.Column="2" Margin="3,3,3,3"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="0" Margin="3,3,3,3">
            <GroupBox.Header>
                <CheckBox Content="Animation" Checked="AnimationCheckBox_Checked" Unchecked="AnimationCheckBox_Unchecked"/>
            </GroupBox.Header>
            <Grid Margin="3,3,3,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="AUto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Name="checkBoxVSync" Content="VSync" Margin="3,3,3,3" Checked="VSyncCheckBox_Checked" Unchecked="VSyncCheckBox_Unchecked"/>

                <Label Content="Framerate" Grid.Row="1" Grid.Column="0"/>
                <Slider
                    x:Name="_fpsSlide"
                    Value="{Binding Path=Value, ElementName=fpsIntegerUpDown, Mode=TwoWay}" Minimum="1" Maximum="60"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxVSync, Converter={StaticResource InverseBooleanConverter}}"
                    VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="3,0,3,0" MinWidth="100"
                    ValueChanged="FpsSlider_ValueChanged"/>
                <xctk:IntegerUpDown Name="fpsIntegerUpDown"
                    Value="60" Minimum="1" Maximum="60"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxVSync, Converter={StaticResource InverseBooleanConverter}}"
                    Grid.Row="1" Grid.Column="2"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
